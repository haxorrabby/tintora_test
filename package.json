{
  "name": "tintora-madrid",
  "version": "1.0.0",
  "description": "Tintora - Impresión de Alta Gama y Soluciones Creativas en Madrid",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/css/main.css -o ./static/dist/css/main.css --minify",
    "watch:css": "tailwindcss -i ./static/src/css/main.css -o ./static/dist/css/main.css --watch",
    "build": "npm run build:css",
    "watch": "npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "alpinejs": "^3.14.8",
    "htmx.org": "^2.0.4"
  }
}
