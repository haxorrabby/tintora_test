# =====================================================================
# TINTORA MADRID - ENVIRONMENT CONFIGURATION
# =====================================================================

# General Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret-of-at-least-50-characters-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Hidden Admin URL (Do NOT use /admin in production)
ADMIN_URL_PATH=gestion-tintora/
# In production use a long, unique secret and do not change it after staff have enrolled TOTP.
TOTP_ENCRYPTION_KEY=
# Optional comma-separated IP/CIDR allowlist for the admin, e.g. 203.0.113.10,203.0.113.0/24
ADMIN_ALLOWED_IPS=
ADMIN_SESSION_IDLE_TIMEOUT=1800

# Database (SQLite default for instant local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://tintora_user:tintora_pass@localhost:5432/tintora_db

# Cache & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Tintora <hola@tintora.es>"
SERVER_EMAIL="servidor@tintora.es"

# Payment Gateways (Stripe, Redsys, Bizum)
# Stripe — disabled by default; set PAYMENTS_STRIPE_ENABLED=True and fill real keys.
PAYMENTS_STRIPE_ENABLED=False
STRIPE_PUBLIC_KEY=pk_test_placeholder_tintora
STRIPE_SECRET_KEY=sk_test_placeholder_tintora
STRIPE_WEBHOOK_SECRET=whsec_placeholder_tintora

# Redsys — leave empty to run in simulation mode (development).
# When empty, Bizum/Redsys fall back to their simulation paths in gateways.py.
REDSYS_MERCHANT_CODE=
REDSYS_SECRET_KEY=
REDSYS_TERMINAL=001
# REDSYS_URL=https://sis-t.redsys.es:25443/sis/realizarPago

# Bank transfer (shown to customers on the payment step)
# TINTORA_BANK_IBAN=ES76 0049 1500 0512 3456 7890
# TINTORA_BANK_BIC=BSCHESMMXXX

# Company Information (Madrid, Spain / Facturación IVA 21%)
COMPANY_NAME=Tintora Impresión y Soluciones Creativas S.L.
COMPANY_NIF_CIF=B-88776655
COMPANY_ADDRESS=C. Núñez de Balboa, 30, Loc 1, 28902 Getafe, Madrid, Spain
COMPANY_PHONE=+34 631 51 76 44
COMPANY_WHATSAPP=+34 631 51 76 44
COMPANY_EMAIL=hola@tintora.es

# Storage (S3 / MinIO - optional in local dev)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=tintora-media
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_ENDPOINT_URL=

# Error tracking (optional — production settings initialise Sentry only if set)
SENTRY_DSN=

# Logging levels (optional)
# DJANGO_LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
